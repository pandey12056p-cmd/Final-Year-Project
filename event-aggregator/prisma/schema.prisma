generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String
  role     String @default("student")

  phone   String?
  college String?
  branch  String?
  year    String?
  profile String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id Int @id @default(autoincrement())

  title    String
  category String @default("General")
  image    String

  description String
  location    String

  mode      String @default("Offline")
  organizer String @default("Event Aggregator")

  date                 DateTime
  registrationDeadline DateTime

  maxParticipants Int @default(100)

  prize    String
  teamSize String

  status String @default("Upcoming")

  certificateAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Registration {
  id Int @id @default(autoincrement())

  eventId Int

  eventTitle String

  fullName String
  email    String
  phone    String

  college String
  branch  String
  year    String

  teamName String?

  reason String

  certificateId String? @unique

  certificateIssued Boolean @default(false)

  certificateIssuedAt DateTime?

  createdAt DateTime @default(now())
}
