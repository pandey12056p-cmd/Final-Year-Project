generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id Int @id @default(autoincrement())

  name     String
  email    String @unique
  password String
  role     String @default("student")

  studentId String?
  phone     String?
  college   String?
  branch    String?
  year      String?
  profile   String?

  skills            String?
  interests         String?
  careerGoal        String?
  preferredDomain   String?
  experienceLevel   String?
  preferredMode     String?
  preferredLocation String?

  githubUrl    String?
  linkedinUrl  String?
  portfolioUrl String?
  bio          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  collegeProfile College?
  reports   Report[]
}

model Event {
  id Int @id @default(autoincrement())

  title    String
  category String @default("General")
  image    String

  description String
  location    String

  mode      String @default("Offline")
  organizer String @default("Event Aggregator")

  date                 DateTime
  endDate              DateTime?
  registrationDeadline DateTime

  maxParticipants Int @default(100)

  prize    String
  teamSize String

  status String @default("Upcoming")

  certificateAvailable Boolean @default(false)

  // New College Panel fields
  collegeId                 Int?
  college                   College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  eligibleColleges          String?
  eligibleCourses           String?
  eligibleBranches          String?
  eligibleYears             String?
  externalStudentsAllowed   Boolean   @default(true)
  isPaid                    Boolean   @default(false)
  registrationFee           Float     @default(0)
  requiredDocuments         String?
  termsAndConditions        String?
  contactDetails            String?
  officialRegistrationLink  String?

  // Audit fields
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  reviewReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reports   Report[]
}

model College {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  code               String
  officialEmail      String   @unique
  website            String
  address            String
  contactDetails     String
  authorizedPerson   String
  logo               String?
  verificationDoc    String?
  status             String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED, SUSPENDED
  rejectReason       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  events             Event[]
}

model Report {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  comment   String?
  createdAt DateTime @default(now())
}

model Registration {
  id Int @id @default(autoincrement())

  eventId Int

  eventTitle String

  fullName String
  email    String
  phone    String

  studentId String?
  gender    String?

  college        String
  branch         String
  year           String
  semester       String?
  specialization String?
  cgpa           String?
  technicalSkills String?

  participationType String? @default("Individual")
  teamName          String?
  teamMembers       String?

  reason String

  previousExperience String?
  relevantSkills     String?
  portfolioUrl       String?
  githubUrl          String?
  linkedinUrl        String?

  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?

  dietaryPreference  String?
  tshirtSize         String?
  accessibilityNeeds String?

  declarationAccepted Boolean @default(true)
  rulesAccepted       Boolean @default(true)
  certificateConsent  Boolean @default(true)

  certificateId String? @unique

  certificateIssued Boolean @default(false)

  certificateIssuedAt DateTime?

  createdAt DateTime @default(now())
}

model SavedEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("info")
  eventId   Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Achievement {
  id          Int      @id @default(autoincrement())
  userId      Int
  code        String
  title       String
  icon        String
  description String
  unlockedAt  DateTime @default(now())

  @@unique([userId, code])
}

model Feedback {
  id        Int      @id @default(autoincrement())
  userId    Int
  eventId   Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  type      String
  createdAt DateTime @default(now())
}

model SkillProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  skillName String
  status    String   @default("Learning") // Not Started | Learning | Completed
  progress  Int      @default(50)
  updatedAt DateTime @updatedAt

  @@unique([userId, skillName])
}

model Reminder {
  id           Int      @id @default(autoincrement())
  userId       Int
  eventId      Int
  reminderDate DateTime
  createdAt    DateTime @default(now())
}
